TURSO_URL=https://your-db-name-org.turso.io
TURSO_TOKEN=your_turso_token_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
STARS_VIP_PRICE=100
STARS_SVIP_PRICE=290
WEBHOOK_SECRET=optional_webhook_secret_token
OWNER_USER_ID=your_telegram_user_id

# Delivery concurrency / rate limiting (DEL-01) — all optional, shown with defaults
DELIVERY_MAX_WORKERS=5            # concurrent users processed per hourly run
DELIVERY_FEED_WORKERS=4           # concurrent feed fetches within one user
TELEGRAM_MAX_MSGS_PER_SEC=25      # global send ceiling across all workers (Telegram cap ~30/s)
